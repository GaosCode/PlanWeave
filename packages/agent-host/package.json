{
  "name": "@planweave-ai/agent-host",
  "version": "0.5.0",
  "description": "Independently deployable Agent Host foundation for PlanWeave.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "planweave-agent-host": "./dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/GaosCode/PlanWeave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaosCode/PlanWeave.git",
    "directory": "packages/agent-host"
  },
  "bugs": {
    "url": "https://github.com/GaosCode/PlanWeave/issues"
  },
  "keywords": [
    "planweave",
    "agent-host",
    "distributed",
    "acp"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test": "cd ../.. && vitest run packages/agent-host/src"
  },
  "dependencies": {
    "@planweave-ai/collaboration-protocol": "workspace:*",
    "@planweave-ai/agent-host-protocol": "workspace:*",
    "@planweave-ai/runtime": "workspace:*",
    "undici": "^7.30.1",
    "ws": "^8.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  }
}
